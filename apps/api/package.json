{
  "name": "@contapp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=src --watch-path=drizzle --watch-path=../../packages/shared/src --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "link-owner": "node --env-file-if-exists=.env --import tsx src/scripts/link-owner.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@contapp/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "openid-client": "6.8.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "oauth2-mock-server": "9.3.0"
  }
}
