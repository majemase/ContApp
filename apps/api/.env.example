# Copia este archivo como .env (no se sube a git).

# Usuario de desarrollo: hace de "usuario con sesión iniciada" hasta que haya IdP.
# local:owner es el dueño de los datos existentes. Pon otro valor para probar con un usuario
# nuevo: se crea solo, con su ámbito Personal. En producción se ignora.
DEV_USER_SUB=local:owner
